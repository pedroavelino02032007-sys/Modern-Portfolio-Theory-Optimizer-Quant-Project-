import numpy as np
import datetime as dt
import pandas as pd
import statsmodels.api as sm
import yfinance as yf
import matplotlib.pyplot as plt
from matplotlib.ticker import PercentFormatter

factor_proxies = ["SPY", "IWM", "IVE", "IVW", "MTUM"]
stocks = []
weights = []

while True:
    stock = input('Enter Stock ticker (press Enter to finish): ').upper()

    if stock == '':
        break
    elif stock in stocks:
        print("Stock already exists")
    else:
        weight = float(input(f'Enter weight for {stock} (in %): '))

        if weight < 0 or weight > 100:
            print("Weight must be between 0 and 100.")
        else:
            stocks.append(stock)
            weights.append(weight / 100)

weights = np.asarray(weights, dtype=float)

print(f"portfolio: {stocks}")

all_tickers = list(dict.fromkeys(stocks + factor_proxies))
years = 5
risk_free_rate = 0.04

end = dt.datetime.now()
start = end - dt.timedelta(days=365 * years)

prices = yf.download(all_tickers ,start=start,end=end,)["Close"]
returns = prices.pct_change().dropna()

stock_returns = returns[stocks]
portfolio_returns = stock_returns @ weights

covariance_matrix = stock_returns.cov() * 252
annual_mean_returns = stock_returns.mean() * 252
variance = float(weights @ covariance_matrix.to_numpy() @ weights)

volatility = np.sqrt(variance)
annual_return = float(weights @ annual_mean_returns)
sharpe_ratio = (annual_return - risk_free_rate) / volatility

marginal_risk = covariance_matrix.to_numpy() @ weights / volatility
component_risk = weights * marginal_risk

standalone_vol = np.sqrt(np.diag(covariance_matrix))
weighted_standalone_vol = float(np.abs(weights) @ standalone_vol)

risk_shares = component_risk / volatility
absolute_component_risk = np.abs(component_risk)

daily_risk_free_returns = risk_free_rate / 252
market_returns = returns["SPY"]

factors = pd.DataFrame(index=returns.index)
factors["MKT"] = market_returns - risk_free_rate / 252
factors["SIZE"] = returns["IWM"] - market_returns
factors["VALUE"] = returns["IVE"] - returns["IVW"]
factors["MOM"] = returns["MTUM"] - market_returns

prices = yf.download(all_tickers,start=start,end=end)["Close"]

common = returns[stocks].join(factors).dropna()
X = sm.add_constant(common[["MKT", "SIZE", "VALUE", "MOM"]])

results = []
daily_risk_free_rate = risk_free_rate / 252

for stock in stocks:
    daily_excess_return = common[stock] - daily_risk_free_rate
    fit = sm.OLS(daily_excess_return, X).fit()

    results.append({
        "stock": stock,
        "annualized_alpha": fit.params["const"] * 252,
        "alpha_t_stat": fit.tvalues["const"],
        "r_squared": fit.rsquared,
        "observations": int(fit.nobs),
        "MKT_beta": fit.params["MKT"],
        "SIZE_beta": fit.params["SIZE"],
        "VALUE_beta": fit.params["VALUE"],
        "MOM_beta": fit.params["MOM"],
    })

factor_results = pd.DataFrame(results).set_index("stock")

print("Factor regression results:")
print(factor_results)
print("asset summary")
print()
print("Portfolio risk summary (annualized estimates)")
print(f"Annual expected return: {annual_return:.2%}")
print(f"Annual volatility: {volatility:.2%}")
print(f"Sharpe ratio: {sharpe_ratio:.3f}")
print(f"Diversification ratio: {weighted_standalone_vol / volatility:.3f}")

# plot results table generated by ChatGPT
fig, axes = plt.subplots(2, 2, figsize=(14, 9))

# Growth of $1
growth = (1 + pd.DataFrame({"Portfolio": portfolio_returns, "SPY": returns["SPY"]})).cumprod()
growth.plot(ax=axes[0, 0], title="Growth of $1")

# Weight vs risk share
rc = pd.DataFrame({"Weight": weights, "Risk share": risk_shares}, index=stocks)
rc.plot.bar(ax=axes[0, 1], title="Capital weight vs risk contribution", rot=0)
axes[0, 1].yaxis.set_major_formatter(PercentFormatter(1.0))

# 3. Factor betas heatmap (portfolio beta = weighted sum of stock betas)
beta_cols = ["MKT_beta", "SIZE_beta", "VALUE_beta", "MOM_beta"]
betas = factor_results[beta_cols].copy()
betas.loc["PORTFOLIO"] = weights @ betas.to_numpy()
lim = np.abs(betas.to_numpy()).max()
ax = axes[1, 0]
im = ax.imshow(betas, cmap="RdBu_r", vmin=-lim, vmax=lim, aspect="auto")
ax.set_xticks(range(len(beta_cols)), [c.replace("_beta", "") for c in beta_cols])
ax.set_yticks(range(len(betas)), betas.index)
for i in range(betas.shape[0]):
    for j in range(betas.shape[1]):
        ax.text(j, i, f"{betas.iloc[i, j]:.2f}", ha="center", va="center")
ax.set_title("Factor betas")
fig.colorbar(im, ax=ax)
# 4. Drawdown
wealth = (1 + portfolio_returns).cumprod()
drawdown = wealth / wealth.cummax() - 1
axes[1, 1].fill_between(drawdown.index, drawdown, 0, color="tab:red", alpha=0.4)
axes[1, 1].yaxis.set_major_formatter(PercentFormatter(1.0))
axes[1, 1].set_title(f"Drawdown (max {drawdown.min():.1%})")

plt.tight_layout()
plt.show()
