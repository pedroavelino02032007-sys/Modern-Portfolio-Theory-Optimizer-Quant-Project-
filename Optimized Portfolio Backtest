import matplotlib.pyplot as plt
import yfinance as yf
import datetime as dt

# enter optimal portfolio
stocks = []
weights = []

while True:
    stock = input('Enter Stock ticker (press Enter to finish): ').upper()

    if stock == '':
        break
    elif stock in stocks:
        print("Stock already exists")
    else:
        weight = float(input(f'Enter weight for {stock} (in %): '))

        if weight < 0 or weight > 100:
            print("Weight must be between 0 and 100.")
        else:
            stocks.append(stock)
            weights.append(weight / 100)

print(f"portfolio: {stocks}")

# Benchmark
benchmark = input("Enter Benchmark ticker : ").upper()

# daily returns
years = 5
end = dt.datetime.now()
start = end - dt.timedelta(days=365 * years)

prices = yf.download(stocks + [benchmark],start=start,end=end,)["Close"]

returns = prices.pct_change().dropna()
portfolio_returns = returns[stocks] @ weights
benchmark_returns = returns[benchmark]

portfolio_growth = (1 + portfolio_returns).cumprod()
benchmark_growth = (1 + benchmark_returns).cumprod()

plt.figure(figsize = (10,6))
plt.plot(portfolio_growth, label='portfolio')
plt.plot(benchmark_growth, label = 'benchmark')
plt.title(f'Portfolio vs {benchmark}')
plt.xlabel('Date')
plt.ylabel('Returns')
plt.legend()
plt.grid()
plt.show()
