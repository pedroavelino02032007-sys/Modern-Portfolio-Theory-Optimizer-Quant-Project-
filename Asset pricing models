import datetime as dt
import yfinance as yf
import statsmodels.api as sm
import numpy as np
import matplotlib.pyplot as plt

stocks = []
weights = []

while True:
    stock = input('Enter Stock ticker (press Enter to finish): ').upper()

    if stock == '':
        break
    elif stock in stocks:
        print("Stock already exists")
    else:
        weight = float(input(f'Enter weight for {stock} (in %): '))

        if weight < 0 or weight > 100:
            print("Weight must be between 0 and 100.")
        else:
            stocks.append(stock)
            weights.append(weight / 100)

print(f"portfolio: {stocks}")

benchmark = 'SPY'

# Returns
years = 5
end = dt.datetime.now()
start = end - dt.timedelta(days=365 * years)

close = yf.download(stocks + [benchmark], start=start, end=end)['Close']

returns = close.pct_change().dropna()
portfolio_returns = returns[stocks].dot(weights)
benchmark_returns = returns[benchmark]

# estimating Beta
mean = benchmark_returns.mean()
n = len(benchmark_returns)
benchmark_variance = ((benchmark_returns - mean) ** 2).sum() / (n - 1)

beta = portfolio_returns.cov(benchmark_returns) / benchmark_variance

tnx = yf.Ticker("^TNX")
data = tnx.history(period="5d")
risk_free = data["Close"].iloc[-1] / 100

capm = risk_free + beta * ((mean * 252) - risk_free) * 100

print(f"Portfolio Expected return (CAPM): {round(capm,2)}%")

# Align portfolio and market returns
data = (portfolio_returns.rename("portfolio").to_frame().join(benchmark_returns.rename("market")).dropna())

# CAPM regression
X = sm.add_constant(data["market"])
y = data["portfolio"]

model = sm.OLS(y, X).fit()
beta = model.params["market"]
alpha_daily = model.params["const"]
alpha_annual = alpha_daily * 252 * 100

print(f"Portfolio Beta: {beta:.3f}")
print(f"Jensen's Alpha (daily): {alpha_daily * 100:.4f}%")
print(f"Jensen's Alpha (annualized): {alpha_annual:.2f}%")
print(f"R-squared: {model.rsquared:.3f}")


# CAPM Regression Plot
plt.figure(figsize=(10, 6))

# Scatter plot of daily returns
plt.scatter(
    data["market"] * 100,
    data["portfolio"] * 100,
    alpha=0.4,
    label="Daily Returns"
)

# Fitted regression line
x = np.linspace(
    data["market"].min(),
    data["market"].max(),
    100
)

y = model.params["const"] + model.params["market"] * x

plt.plot(
    x * 100,
    y * 100,
    linewidth=2,
    label=f"CAPM Regression Line (Beta = {model.params['market']:.2f})"
)

# Labels and title
plt.title("CAPM Regression: Portfolio vs Market")
plt.xlabel("SPY Daily Return (%)")
plt.ylabel("Portfolio Daily Return (%)")

plt.axhline(0, linewidth=0.8, alpha=0.5)
plt.axvline(0, linewidth=0.8, alpha=0.5)

plt.legend()
plt.grid(True, alpha=0.3)
plt.tight_layout()
plt.show()

